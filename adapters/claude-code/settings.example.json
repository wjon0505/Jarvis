{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(node:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree list:*)",
      "Bash(git rev-parse:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(jq:*)",
      "Bash(test:*)",
      "Bash(true)",
      "Read",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf .git*)",
      "Bash(rm -fr .git*)",
      "Bash(rm -rf ./.git*)",
      "Bash(git push* --force*)",
      "Bash(git push* -f*)",
      "Bash(git push* +*)",
      "Bash(git reset*--hard*)",
      "Bash(git clean *)",
      "Bash(git filter-branch*)",
      "Bash(git stash*)",
      "Bash(git worktree remove*--force*)",
      "Bash(git worktree remove*-f*)",
      "Bash(sudo:*)",
      "Bash(npm publish*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ],
    "defaultMode": "acceptEdits"
  }
}
